# ============================================================================
# Madinah Market — environment variables (copy this file to ".env.local"
# for local development, or paste the same names/values into Vercel).
# NEVER share real secret values. NEVER commit .env.local to git.
# ============================================================================

# Public URL of this website (no trailing slash).
# Local: http://localhost:3000   Production: https://your-domain.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase (Project Settings -> API in your Supabase dashboard) ----------
# Public project URL.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
# Public "anon" key — safe to expose in the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# SECRET "service_role" key — SERVER ONLY. It can read/write every order.
# Never put it in browser code, never share it, never send it in chat.
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY

# --- Stripe (Dashboard -> Developers -> API keys) ---------------------------
# SECRET key. Leave EMPTY to run the whole site in TEST MODE
# (orders are marked "test_paid" with no real charge).
STRIPE_SECRET_KEY=
# Public "publishable" key.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE-ME
# SECRET webhook signing secret (Dashboard -> Developers -> Webhooks,
# created for the endpoint https://your-domain.com/api/stripe-webhook).
STRIPE_WEBHOOK_SECRET=whsec_REPLACE-ME

# --- DoorDash Drive (Developer Portal -> Credentials) — Stage 3 -------------
# The ONLY delivery provider now (it replaced Shipday). Leave all three
# EMPTY to run delivery in MOCK mode: quotes are priced from DoorDash's
# published rate card and deliveries are simulated (always labelled
# MOCK in the admin panel). Fill all three in to go LIVE.
# SECRET values — server only, never in browser code, never in chat.
DOORDASH_DEVELOPER_ID=
DOORDASH_KEY_ID=
DOORDASH_SIGNING_SECRET=
# Shared secret YOU invent and also set in the DoorDash Developer
# Portal's webhook settings, so only DoorDash can call
# /api/doordash-webhook. In LIVE mode webhooks without it are rejected.
DOORDASH_WEBHOOK_SECRET=

# --- Twilio SMS (Twilio Console) ---------------------------------------------
# Customer text messages: order confirmation, pickup-ready, delivered.
# Leave EMPTY to disable SMS (sends become no-ops).
# SECRET values — server only.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# The Twilio phone number messages are sent FROM, e.g. +17205550123.
TWILIO_PHONE_NUMBER=

# --- Fresh KDS (kitchen screens) ---------------------------------------------
# When FRESHKDS_TOKEN is set, every paid order is ALSO sent to the
# restaurant's Fresh KDS screens (the site's own /kitchen page is
# unchanged). Leave EMPTY to disable — the integration is then a
# complete no-op.
# SECRET integration token — server only. The owner generates it in
# the Fresh KDS web portal: Settings -> Integration Tokens.
FRESHKDS_TOKEN=
# OPTIONAL: the Fresh KDS location id orders are sent to. Leave empty
# and the site automatically uses the first location on the brand.
FRESHKDS_LOCATION_ID=
# OPTIONAL: API base override (for sandbox testing). Default when
# empty: https://integrations-api.ftservices.cloud
# (sandbox: https://sandbox-integrations-api.ftservices.cloud)
FRESHKDS_API_BASE=

# --- Shipday (delivery provider option — Admin → Operations → Delivery) -----
# SECRET API key — server only. Used only when the delivery provider is
# switched to Shipday. Leave empty to disable Shipday dispatch.
# NOTE: generate a FRESH key in Shipday if an old one was ever shared.
SHIPDAY_API_KEY=
# OPTIONAL shared secret token: invent one, put it here AND in Shipday's
# webhook settings (Shipday sends it in a header named "token"), so only
# Shipday can call https://www.taqwaacenter.com/api/shipday-webhook.
# If left empty the webhook still works, just without the token check.
SHIPDAY_WEBHOOK_TOKEN=

# --- Owner notification ------------------------------------------------------
# Every paid / test-paid order is emailed to this address.
OWNER_NOTIFICATION_EMAIL=Abdolsami@yahoo.com
# OPTIONAL email sending API (for example Resend): if both are set, owner
# emails are sent through it. If empty, order emails are written to the
# server log instead (best-effort; email never blocks an order).
EMAIL_API_URL=
EMAIL_API_KEY=

# --- Business rules ----------------------------------------------------------
TAX_RATE=0.08
RESTAURANT_LAT=39.65987
RESTAURANT_LNG=-104.85051

# TV board test mode: "true" shows ALL recent orders on /display (testing
# only). MUST be "false" for real customers (paid orders, last 4 hours only).
NEXT_PUBLIC_BOARD_TEST_MODE=false
